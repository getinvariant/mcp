{
  "name": "invariant-mcp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "invariant-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:sdk",
    "build:sdk": "node_modules/.bin/esbuild packages/sdk/src/install.ts --bundle --format=esm --platform=node --outfile=dist/sdk-auto.mjs --legal-comments=none --target=node20",
    "start": "node dist/dev-server.js",
    "dev": "npx tsx src/index.ts",
    "test": "npx tsx test.ts",
    "test:prod": "PL_BACKEND_URL=$PL_BACKEND_URL npx tsx test.ts",
    "viz": "npx tsx viz.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/redis": "^1.37.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
